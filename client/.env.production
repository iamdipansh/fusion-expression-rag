# Baked into the production build, so a Vercel import needs no environment variables set.
# This is the public backend URL, not a secret — the Anthropic key is never stored here or
# anywhere else on disk; it lives in browser session state only (see components/ApiKeyControl.tsx).
#
# `next dev` ignores this file in favour of .env.local / the localhost:8000 default in lib/api.ts,
# so local development still points at a locally-running backend.
NEXT_PUBLIC_API_BASE_URL=https://fusion-rag-api.onrender.com
