# Copy to deploy/.env on the VM and fill in — never commit the real .env (already gitignored).

# The VM's public IP in sslip.io form: replace dots with dashes, append .sslip.io.
# e.g. IP 140.238.12.34 -> BACKEND_DOMAIN=140-238-12-34.sslip.io
BACKEND_DOMAIN=

# Comma-separated is NOT valid here — pydantic-settings expects a JSON array for a list field.
# Start with just your Vercel URL once you have it; add more origins as a JSON array if needed.
# e.g. CORS_ORIGINS=["https://fusion-rag.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]

# Optional — only needed if you want the reduced-quality Gemini fallback for callers with no
# Anthropic key. Leave blank to skip it (callers with no key just get a clear "no key" error).
GEMINI_API_KEY=
